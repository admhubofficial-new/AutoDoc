# Supabase project URL (server-side)
SUPABASE_URL=

# Supabase service role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Random secret (at least 32 characters, preferably generated with: openssl rand -base64 48)
SESSION_SECRET=

# Exact origin of this app, e.g. https://autodoc.example.com
APP_ORIGIN=http://localhost:3000
